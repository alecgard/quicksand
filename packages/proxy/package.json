{
  "name": "@quicksand/proxy",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./enforcement": {
      "types": "./dist/enforcement.d.ts",
      "import": "./dist/enforcement.js",
      "default": "./dist/enforcement.js"
    },
    "./credentials": {
      "types": "./dist/credentials.d.ts",
      "import": "./dist/credentials.js",
      "default": "./dist/credentials.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./manifest-manager": {
      "types": "./dist/manifest-manager.d.ts",
      "import": "./dist/manifest-manager.js",
      "default": "./dist/manifest-manager.js"
    },
    "./action-log": {
      "types": "./dist/action-log.d.ts",
      "import": "./dist/action-log.js",
      "default": "./dist/action-log.js"
    },
    "./cost-tracker": {
      "types": "./dist/cost-tracker.d.ts",
      "import": "./dist/cost-tracker.js",
      "default": "./dist/cost-tracker.js"
    },
    "./escalation": {
      "types": "./dist/escalation.d.ts",
      "import": "./dist/escalation.js",
      "default": "./dist/escalation.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@quicksand/manifest": "workspace:*",
    "@quicksand/platform-docker": "workspace:*",
    "hono": "^4",
    "@hono/node-server": "^1",
    "tsx": "^4",
    "zod": "^3"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
